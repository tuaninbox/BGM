<!-- partials/device_listbox.html -->
<div class="border rounded p-3 bg-white overflow-x-auto whitespace-nowrap">

  {% if devices|length == 0 %}
    <p class="text-gray-500">No devices found.</p>
  {% else %}
    <select id="selected-device"
            class="border px-3 py-2 rounded inline-block w-auto">
      {% for d in devices %}
        <option value="{{ d.id }}">
          {{ d.name }} — {{ d.ip }} — {{ d.os }} — {{ d.location }}
        </option>
      {% endfor %}
    </select>
  {% endif %}

</div>
